# Bases brutas: pesadas e obtidas nas fontes oficiais, não versionadas.
# Veja dados/brutos/LEIA-ME.md para saber onde baixar cada uma.
dados/brutos/*
!dados/brutos/LEIA-ME.md

# Arquivos gerados pelo pipeline
dados/*.csv
dados/*.json
dados/*.geojson
dados/saida/
.pytest_cache/

# O protótipo é gerado pelo pipeline, mas fica versionado para abrir sem rodar nada

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Sistema operacional
.DS_Store
Thumbs.db
